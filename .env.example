# ============================================================================
# Niyojan Corporation — Centralized Financial & Billing Management System
# Environment reference (copy to .env and fill in every value)
# ----------------------------------------------------------------------------
# RULES
#   * Sensitive values NEVER use the NEXT_PUBLIC_ prefix — anything with that
#     prefix is embedded into the browser bundle.
#   * The service-role key, SMTP credentials and the two secrets below must
#     never appear in client code, logs, or API responses.
#   * Never hardcode credentials in source files.
# ============================================================================

# --- Initial administrator (bootstrap — used ONCE, at first startup) --------
# The administrator account is created from these values on the very first
# boot ONLY. After that the database record is authoritative: changing these
# variables later has no effect. Change the password through
# /settings/account (Account Settings), which stores an Argon2id hash and
# permanently flips the credential source to the database.
# ADMIN_PASSWORD must satisfy the strong policy: 12-128 characters with
# uppercase, lowercase, a digit and a symbol.
ADMIN_NAME=Deepak Khurana
ADMIN_USERNAME=                        # 3-64 chars: a-z 0-9 . _ -
ADMIN_PASSWORD=                        # 12-128 chars, becomes an Argon2id hash
ADMIN_EMAIL=                           # verification codes are emailed here

# --- Supabase (Project Settings → API) ----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # publishable anon key
SUPABASE_SERVICE_ROLE_KEY=             # SECRET — server-side only, bypasses RLS

# --- SMTP (verification-code email) -------------------------------------------
# An authenticated mailbox (SES, Postmark, Resend SMTP, ...). The code email
# is sent on every login.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                      # true for port 465 (implicit TLS)
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                             # verified sender identity, e.g. auth@yourdomain.com
# Development ONLY (never active in production): capture emails as .eml files
# in SMTP_DEV_OUTBOX instead of sending — used by the test suites.
SMTP_DEV_CAPTURE=false
SMTP_DEV_OUTBOX=.dev-outbox

# --- Authentication secrets ----------------------------------------------------
# Generate with:  openssl rand -base64 48     (the two MUST differ)
AUTH_SESSION_SECRET=
OTP_SECRET=

# --- Application ---------------------------------------------------------------
# Canonical origin of the deployment (no trailing slash), e.g.
# https://admin.yourdomain.com — used for origin validation.
APP_URL=http://localhost:3000

# --- Logo storage (Phases 2 & 3) ------------------------------------------------
# supabase (default / production) — dedicated Storage buckets "firm-logos" and
#   "corporation-logos" (created by supabase/migrations/0002_firms.sql and
#   0003_account_settings.sql; public read, service-role writes only).
# local — DEVELOPMENT/staging adapter for the bundled verification harness
#   (which has no Storage API): files are stored in .data/<area>-logos and
#   served through the sanitized /uploads route. NEVER use in production.
# FIRM_LOGO_STORAGE_MODE is a legacy Phase 2 alias that still takes effect
# when only it is set.
LOGO_STORAGE_MODE=supabase
