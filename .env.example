# ============================================================================
# Niyojan Corporation — Centralized Financial & Billing Management System
# Environment reference (copy to .env locally; configure in Vercel for deploy)
# ----------------------------------------------------------------------------
# RULES
#   * Sensitive values NEVER use the NEXT_PUBLIC_ prefix — anything with that
#     prefix is embedded into the browser bundle.
#   * DATABASE_URL, S3 keys, SMTP credentials and the two secrets below must
#     never appear in client code, logs, or API responses.
#   * Never hardcode credentials in source files.
#   * URL-encode special characters in database passwords (see DEPLOYMENT.md).
# ============================================================================

# --- Application ---------------------------------------------------------------
# NODE_ENV is set by the platform (development/preview/production). Never set
# it manually in Vercel.
NODE_ENV=development
# Canonical origin of the deployment (no trailing slash), used for origin
# validation — e.g. https://niyojan.vercel.app or https://admin.yourdomain.com
APP_URL=http://localhost:3000

# --- Initial administrator (bootstrap — used ONCE, at first startup) -----------
# The administrator account is created from these values on the very first
# bootstrap ONLY (npm run db:bootstrap or the first sign-in attempt). After
# that the database record is authoritative: changing these variables later
# has no effect. Change the password through /settings/account, which stores
# an Argon2id hash and permanently flips the credential source to the database.
# ADMIN_PASSWORD must satisfy the strong policy: 12-128 characters with
# uppercase, lowercase, a digit and a symbol.
ADMIN_NAME=Deepak Khurana
ADMIN_USERNAME=                        # 3-64 chars: a-z 0-9 . _ -
ADMIN_PASSWORD=                        # 12-128 chars, becomes an Argon2id hash
ADMIN_EMAIL=                           # verification codes are emailed here

# --- PostgreSQL (Neon / Lakebase / any standard PostgreSQL) ---------------------
# Pooled connection string for application runtime. Neon: use the POOLED
# endpoint (host contains "-pooler"); Lakebase: use the connection string from
# its console. Special characters in the password MUST be URL-encoded
# (e.g. '@' -> '%40').
# Example: postgresql://user:p%40ssword@ep-cool-name-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Optional DIRECT (unpooled) connection for migrations. Leave empty to reuse
# DATABASE_URL for migrations.
DATABASE_URL_UNPOOLED=

# --- SMTP (verification-code email) ---------------------------------------------
# An authenticated mailbox (SES, Postmark, Resend SMTP, ...). The code email
# is sent on every login.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                      # true for port 465 (implicit TLS)
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                             # verified sender identity, e.g. auth@yourdomain.com
# Development ONLY (never active in production): capture emails as .eml files
# in SMTP_DEV_OUTBOX instead of sending — used by the test suites.
SMTP_DEV_CAPTURE=false
SMTP_DEV_OUTBOX=.dev-outbox

# --- Authentication secrets -----------------------------------------------------
# Generate with:  openssl rand -base64 48     (the two MUST differ)
AUTH_SESSION_SECRET=
OTP_SECRET=

# --- Logo storage ---------------------------------------------------------------
# url  (default) — no object storage configured: logos are set by validated
#   http(s) URLs (or the bundled brand asset is kept). Upload controls are
#   hidden — the app never pretends uploads work.
# s3  — persistent uploads to an S3-compatible object store (AWS S3,
#   Cloudflare R2, Backblaze B2, MinIO, Wasabi, ...). Requires the S3_* group
#   below. Public bucket read policy required (logos are brand assets).
# local — DEVELOPMENT/verification-harness ONLY (filesystem + sanitized
#   /uploads route). NEVER use in production (validation rejects it).
LOGO_STORAGE_MODE=url

# --- S3-compatible object storage (required only when LOGO_STORAGE_MODE=s3) -----
# AWS S3 example:  endpoint empty, region us-east-1, bucket your-bucket
# Cloudflare R2:   endpoint https://<accountid>.r2.cloudflarestorage.com
# MinIO/self-host: endpoint https://your-minio.example.com
S3_ENDPOINT=                           # optional; empty = AWS S3 default
S3_REGION=                             # e.g. us-east-1, ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=                      # SECRET — server-side only
S3_SECRET_ACCESS_KEY=                  # SECRET — server-side only
# Public base for logo URLs; defaults to the provider's bucket URL.
# R2 example: https://cdn.yourdomain.com (or the r2.dev public URL)
S3_PUBLIC_BASE_URL=
