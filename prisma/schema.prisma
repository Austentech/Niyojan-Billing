// Niyojan Corporation — Centralized Financial & Billing Management System
// Data model for the current development phase: admin authentication,
// firm registry, and account settings. Billing / invoice / GST / accounting
// entities are intentionally out of scope and will be added in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Sandbox/dev runs on SQLite. For production on Supabase PostgreSQL, switch
  // provider to "postgresql" and point DATABASE_URL at the Supabase pooler —
  // the schema below is fully portable between both providers.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Administrator accounts. Single-role in this phase (role reserved for
/// future multi-admin expansion).
model AdminUser {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  role           String   @default("ADMIN")
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions            AdminSession[]
  passwordResetTokens PasswordResetToken[]
}

/// Opaque server-side sessions. Only the SHA-256 hash of the cookie token is
/// persisted, so a database leak cannot be replayed as valid cookies.
model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  lastSeenAt DateTime @default(now())
  ipAddress String?
  userAgent String?
  revokedAt DateTime?
}

/// Single-use, expiring password reset tokens (hash of the emailed secret).
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Registered business firms under centralised corporate management.
model Firm {
  id            String     @id @default(cuid())
  name          String
  legalName     String?
  gstin         String?
  contactPerson String?
  email         String?
  phone         String?
  addressLine1  String?
  city          String?
  state         String?
  postalCode    String?
  notes         String?
  status        String     @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
  @@index([name])
}
